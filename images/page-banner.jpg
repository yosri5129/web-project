<svg xmlns="http://www.w3.org/2000/svg" width="1200" height="300" viewBox="0 0 1200 300">
  <!-- Background gradient -->
  <defs>
    <linearGradient id="banner-gradient" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#5E2612" />
      <stop offset="100%" stop-color="#8B4513" />
    </linearGradient>
    <pattern id="spice-texture" width="50" height="50" patternUnits="userSpaceOnUse">
      <circle cx="25" cy="25" r="1" fill="#F4A460" opacity="0.2" />
      <circle cx="10" cy="10" r="0.8" fill="#D2691E" opacity="0.15" />
      <circle cx="40" cy="40" r="1.2" fill="#A0522D" opacity="0.18" />
    </pattern>
  </defs>
  
  <!-- Main background -->
  <rect width="1200" height="300" fill="url(#banner-gradient)" />
  
  <!-- Texture overlay -->
  <rect width="1200" height="300" fill="url(#spice-texture)" />
  
  <!-- Decorative spice elements -->
  <g opacity="0.4">
    <!-- Horizontal spice line -->
    <rect x="0" y="150" width="1200" height="1" fill="#F4A460" opacity="0.5" />
    
    <!-- Scattered spice elements -->
    <g transform="translate(100, 80)">
      <path d="M0,0 L30,20 L0,40 L-30,20 Z" fill="#CD853F" />
    </g>
    <g transform="translate(300, 200)">
      <circle cx="0" cy="0" r="15" fill="#8B4513" />
      <circle cx="0" cy="0" r="8" fill="#A0522D" />
    </g>
    <g transform="translate(500, 100)">
      <ellipse cx="0" cy="0" rx="20" ry="10" fill="#D2691E" />
    </g>
    <g transform="translate(700, 180)">
      <rect x="-15" y="-15" width="30" height="30" fill="#B8860B" transform="rotate(45)" />
    </g>
    <g transform="translate(900, 120)">
      <path d="M0,0 L20,0 L10,20 Z" fill="#A0522D" />
      <path d="M30,0 L50,0 L40,20 Z" fill="#A0522D" />
      <path d="M60,0 L80,0 L70,20 Z" fill="#A0522D" />
    </g>
    <g transform="translate(1100, 220)">
      <circle cx="0" cy="0" r="12" fill="#8B4513" />
      <circle cx="0" cy="0" r="6" fill="#5E2612" />
    </g>
  </g>
  
  <!-- Subtle overlay for better text contrast -->
  <rect width="1200" height="300" fill="rgba(0,0,0,0.3)" />
  
  <!-- Side decorations -->
  <rect x="0" y="0" width="20" height="300" fill="#3E1E0A" opacity="0.7" />
  <rect x="1180" y="0" width="20" height="300" fill="#3E1E0A" opacity="0.7" />
</svg>