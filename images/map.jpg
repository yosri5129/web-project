<svg xmlns="http://www.w3.org/2000/svg" width="600" height="400" viewBox="0 0 600 400">
  <!-- Map background -->
  <rect width="600" height="400" fill="#F0F8FF" stroke="#A9A9A9" stroke-width="2" />
  
  <!-- Roads -->
  <line x1="0" y1="150" x2="600" y2="150" stroke="#D3D3D3" stroke-width="15" />
  <line x1="0" y1="250" x2="600" y2="250" stroke="#D3D3D3" stroke-width="15" />
  <line x1="150" y1="0" x2="150" y2="400" stroke="#D3D3D3" stroke-width="15" />
  <line x1="450" y1="0" x2="450" y2="400" stroke="#D3D3D3" stroke-width="15" />
  
  <!-- Store location marker -->
  <circle cx="300" cy="200" r="20" fill="#FF6347" />
  <circle cx="300" cy="200" r="10" fill="#FFF" />
  
  <!-- Nearby landmarks -->
  <rect x="100" y="100" width="30" height="30" fill="#90EE90" />
  <rect x="500" y="100" width="40" height="30" fill="#ADD8E6" />
  <rect x="100" y="300" width="30" height="50" fill="#D8BFD8" />
  <rect x="500" y="300" width="40" height="30" fill="#FFE4B5" />
  
  <!-- Compass -->
  <circle cx="520" cy="50" r="25" fill="#FFF" stroke="#000" stroke-width="1" />
  <line x1="520" y1="25" x2="520" y2="75" stroke="#000" stroke-width="1" />
  <line x1="495" y1="50" x2="545" y2="50" stroke="#000" stroke-width="1" />
  <text x="520" y="40" font-family="Arial" font-size="10" fill="#000" text-anchor="middle">N</text>
  <text x="520" y="65" font-family="Arial" font-size="10" fill="#000" text-anchor="middle">S</text>
  <text x="505" y="50" font-family="Arial" font-size="10" fill="#000" text-anchor="middle">W</text>
  <text x="535" y="50" font-family="Arial" font-size="10" fill="#000" text-anchor="middle">E</text>
  
  <!-- Legend -->
  <rect x="50" y="350" width="180" height="30" fill="#FFF" stroke="#000" stroke-width="1" />
  <text x="140" y="370" font-family="Arial" font-size="12" fill="#000" text-anchor="middle">Spice Haven Location</text>
  <circle cx="70" cy="365" r="10" fill="#FF6347" />
  <circle cx="70" cy="365" r="5" fill="#FFF" />
  
  <!-- Address -->
  <rect x="200" y="20" width="200" height="40" fill="#FFF" stroke="#000" stroke-width="1" rx="5" ry="5" />
  <text x="300" y="45" font-family="Arial" font-size="12" fill="#333" text-anchor="middle">123 Spice Street, Flavor City</text>
  
  <!-- Street names -->
  <text x="300" y="140" font-family="Arial" font-size="10" fill="#333" text-anchor="middle">Spice Street</text>
  <text x="300" y="240" font-family="Arial" font-size="10" fill="#333" text-anchor="middle">Flavor Avenue</text>
  <text x="140" y="200" font-family="Arial" font-size="10" fill="#333" text-anchor="middle" transform="rotate(-90,140,200)">Culinary Boulevard</text>
  <text x="440" y="200" font-family="Arial" font-size="10" fill="#333" text-anchor="middle" transform="rotate(-90,440,200)">Aroma Drive</text>
</svg>