<svg xmlns="http://www.w3.org/2000/svg" width="300" height="300" viewBox="0 0 300 300">
  <rect width="300" height="300" fill="#F5F5F5" />
  <circle cx="150" cy="100" r="70" fill="#4682B4" />
  <circle cx="150" cy="100" r="65" fill="#FFF" />
  <circle cx="150" cy="100" r="60" fill="#4682B4" />
  <!-- Stylized face -->
  <circle cx="130" cy="85" r="8" fill="#333" />
  <circle cx="170" cy="85" r="8" fill="#333" />
  <path d="M130,120 Q150,130 170,120" stroke="#333" stroke-width="3" fill="none" />
  <!-- Hair -->
  <path d="M100,60 L200,60 L200,100 L100,100 Z" fill="#000" />
  <!-- Body -->
  <rect x="120" y="170" width="60" height="100" fill="#2F4F4F" />
  <text x="150" y="250" font-family="Arial" font-size="16" fill="#333" text-anchor="middle">Michael Chen</text>
  <text x="150" y="270" font-family="Arial" font-size="12" fill="#666" text-anchor="middle">Head of Sourcing</text>
</svg>