<svg xmlns="http://www.w3.org/2000/svg" width="300" height="300" viewBox="0 0 300 300">
  <rect width="300" height="300" fill="#F5F5F5" />
  <circle cx="150" cy="100" r="70" fill="#DA70D6" />
  <circle cx="150" cy="100" r="65" fill="#FFF" />
  <circle cx="150" cy="100" r="60" fill="#DA70D6" />
  <!-- Stylized face -->
  <circle cx="130" cy="85" r="8" fill="#333" />
  <circle cx="170" cy="85" r="8" fill="#333" />
  <path d="M130,120 Q150,140 170,120" stroke="#333" stroke-width="3" fill="none" />
  <!-- Hair -->
  <path d="M90,60 Q150,20 210,60 L210,120 L90,120 Z" fill="#000" />
  <!-- Body -->
  <rect x="120" y="170" width="60" height="100" fill="#9932CC" />
  <text x="150" y="250" font-family="Arial" font-size="16" fill="#333" text-anchor="middle">Priya Patel</text>
  <text x="150" y="270" font-family="Arial" font-size="12" fill="#666" text-anchor="middle">Master Blender</text>
</svg>